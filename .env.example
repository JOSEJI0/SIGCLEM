# Copia este archivo como .env y cambia TODOS los valores. El archivo .env no se sube a Git.

# Base de datos
DB_ROOT_PASS=cambia_esta_contrasena_root
DB_APP_PASS=cambia_esta_contrasena_app
DB_FLYWAY_PASS=cambia_esta_contrasena_flyway

# JWT: cadena aleatoria de al menos 32 caracteres (por ejemplo: openssl rand -base64 48)
JWT_SECRET=

# Origen desde el que se abre la aplicación (sin "/" al final)
CORS_ORIGINS=http://localhost
WEB_PORT=80

# Swagger UI en /api/v1/docs/ui (true solo en desarrollo o pruebas)
API_DOCS=false

# Cuentas iniciales: se crean solo si no existe una cuenta con ese rol (contraseña de 8 o más caracteres).
# Después del primer arranque puedes borrar las contraseñas de este archivo.
COORDINADOR_USUARIO=coordinador
COORDINADOR_CONTRASENA=
JEFA_USUARIO=jefa.dgtv
JEFA_CONTRASENA=
